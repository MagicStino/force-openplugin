[Unit]
Description=OpenPlugin SSH access with an owner-provided public key
RequiresMountsFor=/data
After=network.target
ConditionPathExists=/usr/share/openplugin/authorized_keys
Conflicts=sshd.service

[Service]
Type=simple
ExecStartPre=/bin/sh /usr/share/openplugin/ssh-prepare.sh
ExecStartPre=/usr/sbin/sshd -t -f /usr/share/openplugin/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /usr/share/openplugin/sshd_config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
