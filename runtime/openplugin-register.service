[Unit]
Description=Register the bundled OpenPlugin touchscreen manager
RequiresMountsFor=/media/az01-internal
Before=acvs.service
ConditionPathExistsGlob=/media/az01-internal/Settings/*/MPC.settings

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/share/openplugin/register.sh

[Install]
WantedBy=multi-user.target
